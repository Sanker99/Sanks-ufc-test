{
  "name": "sanks-parlay-demand-collector",
  "main": "index.mjs",
  "compatibility_date": "2026-10-30",
  "workers_dev": false,
  "durable_objects": {
    "bindings": [
      {
        "name": "DEMAND",
        "class_name": "DemandCoordinator"
      }
